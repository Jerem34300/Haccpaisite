# Consolidation SEO : l'ancienne URL /landing.html redirige vers la racine
# indexable (/), qui sert désormais le contenu complet de la landing page
# via index.html. Le "!" force la règle : sans lui, Netlify laisserait le
# fichier landing.html (qui existe toujours physiquement) shadower ce redirect.
/landing.html    /    301!

# Force HTTPS + www in one hop (apex and http www).
# Netlify UI: Domain management → Primary domain MUST be www.hacc.pro
# (DNS/UI setting not in repo). Without that, http://hacc.pro may still
# SSL-upgrade to https://hacc.pro before applying apex→www.
https://hacc.pro/*      https://www.hacc.pro/:splat  301!
http://hacc.pro/*       https://www.hacc.pro/:splat  301!
http://www.hacc.pro/*   https://www.hacc.pro/:splat  301!

# Canonical home: /index.html → /
/index.html    /    301!

# Guides hub canonical is /guides/
/guides/index.html    /guides/    301!

# Guides: .html is canonical (matches <link rel="canonical"> + sitemap).
# Pretty/extensionless URLs 301 to .html (force overrides Netlify pretty URLs).
/guides/plan-maitrise-sanitaire    /guides/plan-maitrise-sanitaire.html    301!
/guides/plat-temoin    /guides/plat-temoin.html    301!
/guides/temperature-haccp    /guides/temperature-haccp.html    301!
